.env
.DS_Store
internal/

__pycache__/
*.pyc
public/lab/node_modules/
public/lab/**/node_modules/

# Top-level npm scratch — used for ad-hoc verification of malicious packages
# (e.g. `npm install @art-ws/config-eslint` to confirm the scanner catches it).
# Never commit these: package.json would advertise a malicious dep, and
# node_modules is a build artifact.
/node_modules/
/package.json
/package-lock.json

# Local backups (e.g. metadata.json.bak from preserve_evidence runs).
*.bak
