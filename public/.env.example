# ─────────────────────────────────────────────
# PoisonChain / Canisterworm 분석 도구 환경 설정
# cp .env.example .env 후 값을 채우세요.
# 이 파일(.env)은 절대 커밋하지 마세요.
# ─────────────────────────────────────────────

# ── XEIZE Open API ───────────────────────────
# scripts/canisterworm_analysis.py, bitbucket_full_scan.py 등
XEIZE_API_KEY=
XEIZE_BASE_URL=https://your-scanner-host/open-api/v1

# ── 사내 포털 계정 (tracert / cmdb 자동 로그인) ──
# scripts/check_external_connectivity.py
# tracert.example.com, infra.example.com 로그인에 사용
HR_PORTAL_ID=your_employee_id
HR_PORTAL_PW=your_password

# ── Jenkins 스캔 ──────────────────────────────
# scripts/jenkins_scan.py

# [방법 1] 단일 서버 — URL + 토큰만 입력 (계정명 불필요, 자동 조회)
JENKINS_URL=https://your-jenkins.example.com
JENKINS_TOKEN=11abc123def456789abcdef

# [방법 2] 토큰 뭉터기 — 여러 담당자에게 받은 토큰을 쉼표로 나열
#           서버마다 맞는 토큰을 자동으로 찾아 매칭
# JENKINS_TOKENS=token1,token2,token3,token4,...
#
# 계정명(사원번호)도 함께 제공하면 자동 매칭 속도 향상
# (미입력 시 admin/jenkins/user 순으로 시도)
# JENKINS_USERNAMES=user1,user2,user3,user4,...

# [방법 3] 서버별 지정 — jenkins-instances.json id 번호로 직접 지정
# JENKINS_TOKEN_1=11abc123...
# JENKINS_TOKEN_9=22def456...

# ── Nexus Repository Manager ─────────────────
# scripts/nexus_proxy_scan.py
# read-only 권한 계정 권장 — nx-search-read + nx-repository-view-npm-*-read 만 부여
# 스크립트는 GET 만 호출하며 컴포넌트/캐시를 수정·삭제하지 않음
NEXUS_BASE_URL=https://nexus.example.com
NEXUS_ID=svc-poisonchain-readonly
NEXUS_PW=********

# ── SSOT 갱신 (Datadog 트리 메타데이터) ────────
# scripts/build_malicious_package_index.py --refresh
# 미설정 시에도 동작하지만 GitHub anonymous rate limit(60 req/hr)에 걸릴 수
# 있습니다. Personal Access Token(권한: public_repo 또는 비공개 클래식 토큰의
# 'repo' 중 어느 것이든 read-only면 충분)을 넣으면 5000 req/hr로 올라갑니다.
# CI(.github/workflows/refresh-malicious-packages.yml)는 자동 GITHUB_TOKEN을
# 쓰므로 이 변수는 로컬 실행 전용입니다.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OSV / KISA 보강 ──────────────────────────
# scripts/supplement_malicious_package_index.py
# api.osv.dev를 익명으로 호출하며 KISA 명단은 supplement-malicious-package-sources.json에
# 정적으로 들어있습니다. 별도의 API 키가 필요 없습니다.
